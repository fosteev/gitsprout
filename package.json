{
  "name": "gitsprout",
  "displayName": "Gitsprout",
  "description": "Multi-repo git overview, commit graph and native diffs for VS Code and Cursor.",
  "version": "0.1.0",
  "publisher": "fosteev",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.git",
    "onWebviewPanel:gitsprout.graph"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitsprout",
          "title": "Gitsprout",
          "icon": "media/sprout.svg"
        }
      ]
    },
    "views": {
      "gitsprout": [
        {
          "id": "gitsprout.repositories",
          "name": "Repositories",
          "when": "gitsprout.multiRepo"
        },
        {
          "id": "gitsprout.branches",
          "name": "Branches"
        },
        {
          "id": "gitsprout.remotes",
          "name": "Remotes"
        },
        {
          "id": "gitsprout.stashes",
          "name": "Stashes"
        },
        {
          "id": "gitsprout.tags",
          "name": "Tags"
        }
      ]
    },
    "commands": [
      {
        "command": "gitsprout.showGraph",
        "title": "Show Graph",
        "category": "Gitsprout",
        "icon": "$(graph)"
      },
      {
        "command": "gitsprout.switchRepository",
        "title": "Switch Repository…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.refresh",
        "title": "Refresh",
        "category": "Gitsprout",
        "icon": "$(refresh)"
      },
      {
        "command": "gitsprout.fetch",
        "title": "Fetch",
        "category": "Gitsprout",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitsprout.fetchAll",
        "title": "Fetch All",
        "category": "Gitsprout",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitsprout.pull",
        "title": "Pull",
        "category": "Gitsprout",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitsprout.push",
        "title": "Push",
        "category": "Gitsprout",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitsprout.checkout",
        "title": "Checkout…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.checkoutBranch",
        "title": "Checkout Branch",
        "category": "Gitsprout",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitsprout.checkoutRemote",
        "title": "Checkout Remote Branch",
        "category": "Gitsprout",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitsprout.createBranch",
        "title": "Create Branch…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.createBranchFrom",
        "title": "Create Branch From…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.renameBranch",
        "title": "Rename Branch…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.deleteBranch",
        "title": "Delete Branch…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.stash",
        "title": "Stash Changes…",
        "category": "Gitsprout",
        "icon": "$(add)"
      },
      {
        "command": "gitsprout.stashApply",
        "title": "Apply Stash",
        "category": "Gitsprout",
        "icon": "$(check)"
      },
      {
        "command": "gitsprout.stashPop",
        "title": "Pop Stash",
        "category": "Gitsprout",
        "icon": "$(export)"
      },
      {
        "command": "gitsprout.stashDrop",
        "title": "Drop Stash…",
        "category": "Gitsprout",
        "icon": "$(trash)"
      },
      {
        "command": "gitsprout.copySha",
        "title": "Copy Commit SHA",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.copyMessage",
        "title": "Copy Commit Message",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.copyBranchName",
        "title": "Copy Branch Name",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.copyRepoPath",
        "title": "Copy Repository Path",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.toggleAutoBuild",
        "title": "Toggle Hide CI Commits",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.toggleOnlyAttention",
        "title": "Toggle Only Repositories Needing Attention",
        "category": "Gitsprout",
        "icon": "$(filter)",
        "toggled": {
          "condition": "gitsprout.onlyAttention",
          "icon": "$(check)"
        }
      },
      {
        "command": "gitsprout.openSourceControl",
        "title": "Open Source Control",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.repoShowGraph",
        "title": "Show Graph",
        "category": "Gitsprout",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitsprout.repoFetch",
        "title": "Fetch",
        "category": "Gitsprout",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitsprout.openStashFile",
        "title": "Open Changes",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.resetSoft",
        "title": "Soft — keep changes staged",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.resetMixed",
        "title": "Mixed — keep changes unstaged",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.resetHard",
        "title": "Hard — discard changes",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.cherryPick",
        "title": "Cherry Pick Commit",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.revert",
        "title": "Revert Commit",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.compareWithWorktree",
        "title": "Compare with Working Tree",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.savePatch",
        "title": "Save as Patch…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.createTag",
        "title": "Create Tag Here…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.createAnnotatedTag",
        "title": "Create Annotated Tag Here…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.deleteTag",
        "title": "Delete Tag",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.pushTag",
        "title": "Push Tag",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.copyCommitLink",
        "title": "Copy Link to Commit",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.copyBranchLink",
        "title": "Copy Link to Branch",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.setUpstream",
        "title": "Set Upstream…",
        "category": "Gitsprout"
      }
    ],
    "submenus": [
      {
        "id": "gitsprout.resetSubmenu",
        "label": "Reset Current Branch to Here"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitsprout.fetch",
          "when": "view == gitsprout.branches",
          "group": "navigation@1"
        },
        {
          "command": "gitsprout.pull",
          "when": "view == gitsprout.branches",
          "group": "navigation@2"
        },
        {
          "command": "gitsprout.push",
          "when": "view == gitsprout.branches",
          "group": "navigation@3"
        },
        {
          "command": "gitsprout.showGraph",
          "when": "view == gitsprout.branches",
          "group": "navigation@4"
        },
        {
          "command": "gitsprout.fetchAll",
          "when": "view == gitsprout.repositories",
          "group": "navigation@1"
        },
        {
          "command": "gitsprout.toggleOnlyAttention",
          "when": "view == gitsprout.repositories",
          "group": "navigation@2"
        },
        {
          "command": "gitsprout.stash",
          "when": "view == gitsprout.stashes",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gitsprout.repoShowGraph",
          "when": "view == gitsprout.repositories && viewItem == repo",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.repoFetch",
          "when": "view == gitsprout.repositories && viewItem == repo",
          "group": "inline@2"
        },
        {
          "command": "gitsprout.copyRepoPath",
          "when": "view == gitsprout.repositories && viewItem == repo",
          "group": "1_copy"
        },
        {
          "command": "gitsprout.checkoutBranch",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.renameBranch",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "1_modify@1"
        },
        {
          "command": "gitsprout.deleteBranch",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "1_modify@2"
        },
        {
          "command": "gitsprout.createBranchFrom",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "2_create"
        },
        {
          "command": "gitsprout.copyBranchName",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.renameBranch",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "1_modify"
        },
        {
          "command": "gitsprout.createBranchFrom",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "2_create"
        },
        {
          "command": "gitsprout.copyBranchName",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.checkoutRemote",
          "when": "view == gitsprout.remotes && viewItem == branch.remote",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.createBranchFrom",
          "when": "view == gitsprout.remotes && viewItem == branch.remote",
          "group": "2_create"
        },
        {
          "command": "gitsprout.copyBranchName",
          "when": "view == gitsprout.remotes && viewItem == branch.remote",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.stashApply",
          "when": "view == gitsprout.stashes && viewItem == stash",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.stashPop",
          "when": "view == gitsprout.stashes && viewItem == stash",
          "group": "inline@2"
        },
        {
          "command": "gitsprout.stashDrop",
          "when": "view == gitsprout.stashes && viewItem == stash",
          "group": "inline@3"
        },
        {
          "command": "gitsprout.createBranchFrom",
          "when": "view == gitsprout.tags && viewItem == tag",
          "group": "2_create"
        },
        {
          "command": "gitsprout.copyBranchName",
          "when": "view == gitsprout.tags && viewItem == tag",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.pull",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.push",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "inline@2"
        },
        {
          "command": "gitsprout.openStashFile",
          "when": "view == gitsprout.stashes && viewItem == stashFile",
          "group": "navigation"
        },
        {
          "command": "gitsprout.pushTag",
          "when": "view == gitsprout.tags && viewItem == tag",
          "group": "1_remote"
        },
        {
          "command": "gitsprout.deleteTag",
          "when": "view == gitsprout.tags && viewItem == tag",
          "group": "1_modify"
        },
        {
          "command": "gitsprout.setUpstream",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "1_modify@3"
        },
        {
          "command": "gitsprout.copyBranchLink",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.setUpstream",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "1_modify@3"
        },
        {
          "command": "gitsprout.copyBranchLink",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.copyBranchLink",
          "when": "view == gitsprout.remotes && viewItem == branch.remote",
          "group": "3_copy"
        }
      ],
      "webview/context": [
        {
          "command": "gitsprout.createBranchFrom",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "1_create@1"
        },
        {
          "command": "gitsprout.copySha",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
