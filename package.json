{
  "name": "gitsprout",
  "displayName": "Gitsprout",
  "description": "Multi-repo git overview, commit graph and native diffs for VS Code and Cursor.",
  "version": "0.4.0",
  "publisher": "fosteev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fosteev/gitsprout.git"
  },
  "bugs": {
    "url": "https://github.com/fosteev/gitsprout/issues"
  },
  "homepage": "https://github.com/fosteev/gitsprout#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "graph",
    "multi-repo",
    "branches",
    "stash",
    "commit graph",
    "monorepo",
    "workspace"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.git",
    "onWebviewPanel:gitsprout.graph"
  ],
  "contributes": {
    "colors": [
      {
        "id": "gitsprout.currentForeground",
        "description": "Label and icon colour of the checked-out branch and the active repository.",
        "defaults": {
          "dark": "charts.green",
          "light": "charts.green",
          "highContrast": "charts.green",
          "highContrastLight": "charts.green"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitsprout",
          "title": "Gitsprout",
          "icon": "media/sprout.svg"
        }
      ]
    },
    "views": {
      "gitsprout": [
        {
          "id": "gitsprout.repositories",
          "name": "Repositories",
          "when": "gitsprout.multiRepo"
        },
        {
          "id": "gitsprout.worktrees",
          "name": "Worktrees"
        },
        {
          "id": "gitsprout.branches",
          "name": "Branches"
        },
        {
          "id": "gitsprout.remotes",
          "name": "Remotes"
        },
        {
          "id": "gitsprout.stashes",
          "name": "Stashes"
        },
        {
          "id": "gitsprout.tags",
          "name": "Tags"
        }
      ]
    },
    "commands": [
      {
        "command": "gitsprout.showGraph",
        "title": "Show Graph",
        "category": "Gitsprout",
        "icon": "$(graph)"
      },
      {
        "command": "gitsprout.switchRepository",
        "title": "Switch Repository…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.refresh",
        "title": "Refresh",
        "category": "Gitsprout",
        "icon": "$(refresh)"
      },
      {
        "command": "gitsprout.fetch",
        "title": "Fetch",
        "category": "Gitsprout",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitsprout.fetchAll",
        "title": "Fetch All",
        "category": "Gitsprout",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitsprout.pull",
        "title": "Pull",
        "category": "Gitsprout",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitsprout.push",
        "title": "Push",
        "category": "Gitsprout",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitsprout.checkout",
        "title": "Checkout…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.checkoutBranch",
        "title": "Checkout Branch",
        "category": "Gitsprout",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitsprout.checkoutRemote",
        "title": "Checkout Remote Branch",
        "category": "Gitsprout",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitsprout.createBranch",
        "title": "Create Branch…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.createBranchFrom",
        "title": "Create Branch From…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.renameBranch",
        "title": "Rename Branch…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.deleteBranch",
        "title": "Delete Branch…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.stash",
        "title": "Stash Changes…",
        "category": "Gitsprout",
        "icon": "$(add)"
      },
      {
        "command": "gitsprout.stashApply",
        "title": "Apply Stash",
        "category": "Gitsprout",
        "icon": "$(check)"
      },
      {
        "command": "gitsprout.stashPop",
        "title": "Pop Stash",
        "category": "Gitsprout",
        "icon": "$(export)"
      },
      {
        "command": "gitsprout.stashDrop",
        "title": "Drop Stash…",
        "category": "Gitsprout",
        "icon": "$(trash)"
      },
      {
        "command": "gitsprout.copySha",
        "title": "Copy Commit SHA",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.copyMessage",
        "title": "Copy Commit Message",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.copyBranchName",
        "title": "Copy Branch Name",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.copyRepoPath",
        "title": "Copy Repository Path",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.toggleAutoBuild",
        "title": "Toggle Hide CI Commits",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.toggleOnlyAttention",
        "title": "Toggle Only Repositories Needing Attention",
        "category": "Gitsprout",
        "icon": "$(filter)",
        "toggled": {
          "condition": "gitsprout.onlyAttention",
          "icon": "$(check)"
        }
      },
      {
        "command": "gitsprout.openSourceControl",
        "title": "Open Source Control",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.repoShowGraph",
        "title": "Show Graph",
        "category": "Gitsprout",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitsprout.repoFetch",
        "title": "Fetch",
        "category": "Gitsprout",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitsprout.openStashFile",
        "title": "Open Changes",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.resetSoft",
        "title": "Soft — keep changes staged",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.resetMixed",
        "title": "Mixed — keep changes unstaged",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.resetHard",
        "title": "Hard — discard changes",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.cherryPick",
        "title": "Cherry Pick Commit",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.revert",
        "title": "Revert Commit",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.compareWithWorktree",
        "title": "Compare with Working Tree",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.savePatch",
        "title": "Save as Patch…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.wipStage",
        "title": "Stage",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.wipUnstage",
        "title": "Unstage",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.wipDiscard",
        "title": "Discard Changes",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.downloadGoogleFont",
        "title": "Download Google Font for the Diff…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.removeGoogleFont",
        "title": "Remove Downloaded Google Font…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.worktreeCreate",
        "title": "Create Worktree…",
        "category": "Gitsprout",
        "icon": "$(add)"
      },
      {
        "command": "gitsprout.worktreeCreateFrom",
        "title": "Create Worktree from Branch…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.worktreeOpenGraph",
        "title": "Open Worktree Graph",
        "category": "Gitsprout",
        "icon": "$(graph)"
      },
      {
        "command": "gitsprout.worktreeOpenWindow",
        "title": "Open Worktree in New Window",
        "category": "Gitsprout",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "gitsprout.worktreeOpenHere",
        "title": "Open Worktree in This Window",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.worktreeAddToWorkspace",
        "title": "Add Worktree to Workspace",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.worktreeTerminal",
        "title": "Open Terminal in Worktree",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.worktreeReveal",
        "title": "Reveal Worktree in File Manager",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.worktreeCopyPath",
        "title": "Copy Worktree Path",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.worktreeRemove",
        "title": "Remove Worktree…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.worktreeUnlock",
        "title": "Unlock Worktree",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.worktreePrune",
        "title": "Prune Worktrees…",
        "category": "Gitsprout",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitsprout.switchWorktree",
        "title": "Switch Worktree…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.createTag",
        "title": "Create Tag Here…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.createAnnotatedTag",
        "title": "Create Annotated Tag Here…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.deleteTag",
        "title": "Delete Tag",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.pushTag",
        "title": "Push Tag",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.copyCommitLink",
        "title": "Copy Link to Commit",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.copyBranchLink",
        "title": "Copy Link to Branch",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.setUpstream",
        "title": "Set Upstream…",
        "category": "Gitsprout"
      },
      {
        "command": "gitsprout.openSettings",
        "title": "Open Settings",
        "category": "Gitsprout",
        "icon": "$(gear)"
      }
    ],
    "submenus": [
      {
        "id": "gitsprout.resetSubmenu",
        "label": "Reset Current Branch to Here"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitsprout.fetch",
          "when": "view == gitsprout.branches",
          "group": "navigation@1"
        },
        {
          "command": "gitsprout.pull",
          "when": "view == gitsprout.branches",
          "group": "navigation@2"
        },
        {
          "command": "gitsprout.push",
          "when": "view == gitsprout.branches",
          "group": "navigation@3"
        },
        {
          "command": "gitsprout.showGraph",
          "when": "view == gitsprout.branches",
          "group": "navigation@4"
        },
        {
          "command": "gitsprout.fetchAll",
          "when": "view == gitsprout.repositories",
          "group": "navigation@1"
        },
        {
          "command": "gitsprout.toggleOnlyAttention",
          "when": "view == gitsprout.repositories",
          "group": "navigation@2"
        },
        {
          "command": "gitsprout.openSettings",
          "when": "view == gitsprout.repositories",
          "group": "navigation@3"
        },
        {
          "command": "gitsprout.stash",
          "when": "view == gitsprout.stashes",
          "group": "navigation@1"
        },
        {
          "command": "gitsprout.worktreeCreate",
          "when": "view == gitsprout.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "gitsprout.worktreePrune",
          "when": "view == gitsprout.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "gitsprout.refresh",
          "when": "view == gitsprout.worktrees",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitsprout.repoShowGraph",
          "when": "view == gitsprout.repositories && viewItem == repo",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.repoFetch",
          "when": "view == gitsprout.repositories && viewItem == repo",
          "group": "inline@2"
        },
        {
          "command": "gitsprout.copyRepoPath",
          "when": "view == gitsprout.repositories && viewItem == repo",
          "group": "1_copy"
        },
        {
          "command": "gitsprout.checkoutBranch",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.renameBranch",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "1_modify@1"
        },
        {
          "command": "gitsprout.deleteBranch",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "1_modify@2"
        },
        {
          "command": "gitsprout.createBranchFrom",
          "when": "view == gitsprout.branches && viewItem =~ /^branch\\.local(\\.worktree)?$/",
          "group": "2_create"
        },
        {
          "command": "gitsprout.worktreeCreateFrom",
          "when": "view == gitsprout.branches && viewItem == branch.local",
          "group": "2_create@2"
        },
        {
          "command": "gitsprout.worktreeOpenGraph",
          "when": "view == gitsprout.branches && viewItem == branch.local.worktree",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.worktreeOpenGraph",
          "when": "view == gitsprout.branches && viewItem == branch.local.worktree",
          "group": "1_worktree@1"
        },
        {
          "command": "gitsprout.worktreeOpenWindow",
          "when": "view == gitsprout.branches && viewItem == branch.local.worktree",
          "group": "1_worktree@2"
        },
        {
          "command": "gitsprout.copyBranchName",
          "when": "view == gitsprout.branches && viewItem =~ /^branch\\.local(\\.worktree)?$/",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.renameBranch",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "1_modify"
        },
        {
          "command": "gitsprout.createBranchFrom",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "2_create"
        },
        {
          "command": "gitsprout.copyBranchName",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.checkoutRemote",
          "when": "view == gitsprout.remotes && viewItem == branch.remote",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.createBranchFrom",
          "when": "view == gitsprout.remotes && viewItem == branch.remote",
          "group": "2_create"
        },
        {
          "command": "gitsprout.copyBranchName",
          "when": "view == gitsprout.remotes && viewItem == branch.remote",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.stashApply",
          "when": "view == gitsprout.stashes && viewItem == stash",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.stashPop",
          "when": "view == gitsprout.stashes && viewItem == stash",
          "group": "inline@2"
        },
        {
          "command": "gitsprout.stashDrop",
          "when": "view == gitsprout.stashes && viewItem == stash",
          "group": "inline@3"
        },
        {
          "command": "gitsprout.createBranchFrom",
          "when": "view == gitsprout.tags && viewItem == tag",
          "group": "2_create"
        },
        {
          "command": "gitsprout.copyBranchName",
          "when": "view == gitsprout.tags && viewItem == tag",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.pull",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.push",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "inline@2"
        },
        {
          "command": "gitsprout.openStashFile",
          "when": "view == gitsprout.stashes && viewItem == stashFile",
          "group": "navigation"
        },
        {
          "command": "gitsprout.pushTag",
          "when": "view == gitsprout.tags && viewItem == tag",
          "group": "1_remote"
        },
        {
          "command": "gitsprout.deleteTag",
          "when": "view == gitsprout.tags && viewItem == tag",
          "group": "1_modify"
        },
        {
          "command": "gitsprout.setUpstream",
          "when": "view == gitsprout.branches && viewItem =~ /^branch\\.local(\\.worktree)?$/",
          "group": "1_modify@3"
        },
        {
          "command": "gitsprout.copyBranchLink",
          "when": "view == gitsprout.branches && viewItem =~ /^branch\\.local(\\.worktree)?$/",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.setUpstream",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "1_modify@3"
        },
        {
          "command": "gitsprout.copyBranchLink",
          "when": "view == gitsprout.branches && viewItem == branch.local.head",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.copyBranchLink",
          "when": "view == gitsprout.remotes && viewItem == branch.remote",
          "group": "3_copy"
        },
        {
          "command": "gitsprout.worktreeOpenGraph",
          "when": "view == gitsprout.worktrees && viewItem =~ /^worktree(\\.main|\\.current|\\.locked)?$/",
          "group": "inline@1"
        },
        {
          "command": "gitsprout.worktreeOpenWindow",
          "when": "view == gitsprout.worktrees && viewItem =~ /^worktree(\\.main|\\.locked)?$/",
          "group": "inline@2"
        },
        {
          "command": "gitsprout.worktreeOpenGraph",
          "when": "view == gitsprout.worktrees && viewItem =~ /^worktree(\\.main|\\.current|\\.locked)?$/",
          "group": "1_open@1"
        },
        {
          "command": "gitsprout.worktreeOpenWindow",
          "when": "view == gitsprout.worktrees && viewItem =~ /^worktree(\\.main|\\.locked)?$/",
          "group": "1_open@2"
        },
        {
          "command": "gitsprout.worktreeOpenHere",
          "when": "view == gitsprout.worktrees && viewItem =~ /^worktree(\\.main|\\.locked)?$/",
          "group": "1_open@3"
        },
        {
          "command": "gitsprout.worktreeAddToWorkspace",
          "when": "view == gitsprout.worktrees && viewItem =~ /^worktree(\\.main|\\.current|\\.locked)?$/",
          "group": "1_open@4"
        },
        {
          "command": "gitsprout.worktreeTerminal",
          "when": "view == gitsprout.worktrees && viewItem =~ /^worktree(\\.main|\\.current|\\.locked)?$/",
          "group": "2_tools@1"
        },
        {
          "command": "gitsprout.worktreeReveal",
          "when": "view == gitsprout.worktrees && viewItem =~ /^worktree(\\.main|\\.current|\\.locked)?$/",
          "group": "2_tools@2"
        },
        {
          "command": "gitsprout.worktreeCopyPath",
          "when": "view == gitsprout.worktrees && viewItem =~ /^worktree/",
          "group": "2_tools@3"
        },
        {
          "command": "gitsprout.worktreeUnlock",
          "when": "view == gitsprout.worktrees && viewItem == worktree.locked",
          "group": "3_manage@1"
        },
        {
          "command": "gitsprout.worktreeRemove",
          "when": "view == gitsprout.worktrees && viewItem =~ /^worktree(\\.locked)?$/",
          "group": "3_manage@2"
        },
        {
          "command": "gitsprout.worktreePrune",
          "when": "view == gitsprout.worktrees && viewItem == worktree.missing",
          "group": "3_manage@3"
        }
      ],
      "webview/context": [
        {
          "command": "gitsprout.worktreeOpenGraph",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'worktree'",
          "group": "1_open@1"
        },
        {
          "command": "gitsprout.worktreeOpenWindow",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'worktree'",
          "group": "1_open@2"
        },
        {
          "command": "gitsprout.worktreeRemove",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'worktree' && !worktreeMain",
          "group": "9_remove@1"
        },
        {
          "command": "gitsprout.createBranchFrom",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "1_create@1"
        },
        {
          "command": "gitsprout.worktreeCreateFrom",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "1_create@2"
        },
        {
          "command": "gitsprout.copySha",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "2_copy@1"
        },
        {
          "command": "gitsprout.copyMessage",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "2_copy@2"
        },
        {
          "command": "gitsprout.createTag",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "1_create@2"
        },
        {
          "command": "gitsprout.createAnnotatedTag",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "1_create@3"
        },
        {
          "command": "gitsprout.copyCommitLink",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "2_copy@3"
        },
        {
          "submenu": "gitsprout.resetSubmenu",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "3_modify@1"
        },
        {
          "command": "gitsprout.cherryPick",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "3_modify@2"
        },
        {
          "command": "gitsprout.revert",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "3_modify@3"
        },
        {
          "command": "gitsprout.compareWithWorktree",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "4_compare@1"
        },
        {
          "command": "gitsprout.savePatch",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "4_compare@2"
        },
        {
          "command": "gitsprout.wipStage",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'wip' && wipArea == 'unstaged'",
          "group": "1_stage@1"
        },
        {
          "command": "gitsprout.wipUnstage",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'wip' && wipArea == 'staged'",
          "group": "1_stage@1"
        },
        {
          "command": "gitsprout.wipDiscard",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'wip' && wipCanDiscard",
          "group": "2_discard@1"
        }
      ],
      "gitsprout.resetSubmenu": [
        {
          "command": "gitsprout.resetSoft",
          "group": "reset@1"
        },
        {
          "command": "gitsprout.resetMixed",
          "group": "reset@2"
        },
        {
          "command": "gitsprout.resetHard",
          "group": "reset@3"
        }
      ],
