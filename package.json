          "when": "false"
        },
        {
          "command": "gitsprout.stashDrop",
          "when": "false"
        },
        {
          "command": "gitsprout.copySha",
          "when": "false"
        },
        {
          "command": "gitsprout.copyMessage",
          "when": "false"
        },
        {
          "command": "gitsprout.copyBranchName",
          "when": "false"
        },
        {
          "command": "gitsprout.copyRepoPath",
          "when": "false"
        },
        {
          "command": "gitsprout.repoShowGraph",
          "when": "false"
        },
        {
          "command": "gitsprout.repoFetch",
          "when": "false"
        },
        {
          "command": "gitsprout.createTag",
          "when": "false"
        },
        {
          "command": "gitsprout.createAnnotatedTag",
          "when": "false"
        },
        {
          "command": "gitsprout.deleteTag",
          "when": "false"
        },
        {
          "command": "gitsprout.pushTag",
          "when": "false"
        },
        {
          "command": "gitsprout.copyCommitLink",
          "when": "false"
        },
        {
          "command": "gitsprout.copyBranchLink",
          "when": "false"
        },
        {
          "command": "gitsprout.setUpstream",
          "when": "false"
        },
        {
          "command": "gitsprout.resetSoft",
          "when": "false"
        },
        {
          "command": "gitsprout.resetMixed",
          "when": "false"
        },
        {
          "command": "gitsprout.resetHard",
          "when": "false"
        },
        {
          "command": "gitsprout.cherryPick",
          "when": "false"
        },
        {
          "command": "gitsprout.revert",
          "when": "false"
        },
        {
          "command": "gitsprout.compareWithWorktree",
          "when": "false"
        },
        {
          "command": "gitsprout.savePatch",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitsprout.showGraph",
        "key": "ctrl+alt+g",
        "mac": "alt+cmd+g"
      },
      {
        "command": "gitsprout.switchRepository",
        "key": "ctrl+alt+r",
        "mac": "alt+cmd+r"
      }
    ],
    "configuration": {
      "title": "Gitsprout",
      "properties": {
        "gitsprout.scanDepth": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "How deep to scan workspace folders for git repositories."
        },
        "gitsprout.scanExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules",
            "**/vendor"
          ],
          "description": "Glob patterns skipped during repository discovery."
        },
        "gitsprout.logLimit": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "description": "Maximum number of commits loaded into the graph."
        },
        "gitsprout.ciPattern": {
          "type": "string",
          "default": "^AutoBuild$",
          "description": "Regular expression matching CI commit subjects (hidden when hideCi is on)."
        },
        "gitsprout.hideCi": {
          "type": "boolean",
          "default": false,
          "description": "Hide CI commits in the graph."
        },
        "gitsprout.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Switch the active repository to the one containing the active editor."
        },
        "gitsprout.fetchConcurrency": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Number of repositories fetched in parallel by Fetch All."
        },
        "gitsprout.jira": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "P7": "https://jira.pilot-gps.com/browse/",
            "GARM": "https://jira.pilot-gps.com/browse/",
            "PILOTADM": "https://jira.pilot-gps.com/browse/",
            "RNTBST": "https://jira.pilot-gps.com/browse/",
            "NEWMFC": "https://jira.sccloud.ru/browse/",
            "RPGU": "https://jira.sccloud.ru/browse/",
            "SITCENTER": "https://jira.sccloud.ru/browse/",
            "VBV": "https://atlassian.tatikoma.ru/jira/browse/",
            "MFCDEV": "https://atlassian.tatikoma.ru/jira/browse/",
            "SDU": "https://atlassian.tatikoma.ru/jira/browse/"
          },
          "description": "Jira project key to browse URL prefix; keys in commit messages become links."
        }
      }
    },
    "viewsWelcome": [
