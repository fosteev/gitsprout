          "group": "1_create@3"
        },
        {
          "command": "gitsprout.copyCommitLink",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "2_copy@3"
        },
        {
          "submenu": "gitsprout.resetSubmenu",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "3_modify@1"
        },
        {
          "command": "gitsprout.cherryPick",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "3_modify@2"
        },
        {
          "command": "gitsprout.revert",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "3_modify@3"
        },
        {
          "command": "gitsprout.compareWithWorktree",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "4_compare@1"
        },
        {
          "command": "gitsprout.savePatch",
          "when": "webviewId == 'gitsprout.graph' && webviewSection == 'commit'",
          "group": "4_compare@2"
        }
      ],
