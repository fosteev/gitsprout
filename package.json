    "configuration": [
      {
        "title": "Diff",
        "order": 0,
        "properties": {
          "gitsprout.diff.syntaxHighlighting": {
            "type": "boolean",
            "default": true,
            "description": "Highlight syntax in the graph's inline diff.",
            "order": 0
          },
          "gitsprout.diff.highlightTheme": {
            "type": "string",
            "enum": [
              "auto",
              "simple",
              "github",
              "one"
            ],
            "enumDescriptions": [
              "Use the colours of the active VS Code colour theme.",
              "A small VS Code-like palette: comments, keywords, strings and numbers.",
              "GitHub-like palette.",
              "One Dark / One Light-like palette."
            ],
            "default": "auto",
            "description": "Colour palette of the highlighted diff.",
            "order": 1
          },
          "gitsprout.diff.fontFamily": {
            "type": "string",
            "default": "",
            "description": "Font family of the inline diff. Empty = editor.fontFamily.",
            "order": 2
          },
          "gitsprout.diff.fontSize": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "maximum": 40,
            "description": "Font size of the inline diff in pixels. 0 = editor.fontSize.",
            "order": 3
          }
        }
      },
      {
        "title": "Graph",
        "order": 1,
        "properties": {
          "gitsprout.logLimit": {
            "type": "number",
            "default": 1000,
            "minimum": 1,
            "description": "Maximum number of commits loaded into the graph.",
            "order": 0
          },
          "gitsprout.ciPattern": {
            "type": "string",
            "default": "^AutoBuild$",
            "description": "Regular expression matching CI commit subjects (hidden when hideCi is on).",
            "order": 1
          },
          "gitsprout.hideCi": {
            "type": "boolean",
            "default": false,
            "description": "Hide CI commits in the graph.",
            "order": 2
          }
        }
      },
      {
        "title": "Repositories",
        "order": 2,
        "properties": {
          "gitsprout.scanDepth": {
            "type": "number",
            "default": 3,
            "minimum": 0,
            "description": "How deep to scan workspace folders for git repositories.",
            "order": 0
          },
          "gitsprout.scanExclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/node_modules",
              "**/vendor"
            ],
            "description": "Glob patterns skipped during repository discovery.",
            "order": 1
          },
          "gitsprout.followActiveEditor": {
            "type": "boolean",
            "default": true,
            "description": "Switch the active repository to the one containing the active editor.",
            "order": 2
          },
          "gitsprout.fetchConcurrency": {
            "type": "number",
            "default": 4,
            "minimum": 1,
            "description": "Number of repositories fetched in parallel by Fetch All.",
            "order": 3
          }
        }
      },
      {
        "title": "Worktrees",
        "order": 3,
        "properties": {
          "gitsprout.worktreeFolder": {
            "type": "string",
            "default": "",
            "description": "Folder for new worktrees: <folder>/<repo name>/<branch>. Empty = next to the repository, in <repo>.worktrees/<branch>. A leading ~ is the home directory.",
            "order": 0
          }
        }
      },
      {
        "title": "Jira",
        "order": 4,
        "properties": {
          "gitsprout.jira": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Jira project key to browse URL prefix, e.g. {\"PROJ\": \"https://jira.example.com/browse/\"}; keys in commit messages become links.",
            "order": 0
          }
        }
      }
    ],
    "viewsWelcome": [
      {
        "view": "gitsprout.branches",
        "contents": "No branches.",
        "when": "gitsprout.refsState == 'ok'"
      },
      {
        "view": "gitsprout.branches",
